+  UINTN size=EFI_ERROR(status)?0:(UINTN)data.info.FileSize,done=0;
+  while(!EFI_ERROR(status) && done<size) {
+    UINTN want=size-done;
+    status=file->Read(file,&want,Out+done);
+    if(!EFI_ERROR(status)) {if(!want)status=EFI_END_OF_FILE;else done+=want;}
